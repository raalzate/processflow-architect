{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "index.ts",
    "../main/services/mcp-tools.ts",
    "../src/lib/mcp/**/*.ts",
    "../src/lib/notations.ts",
    "../src/lib/types.ts"
  ]
}
