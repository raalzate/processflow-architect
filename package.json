{
  "name": "processflow-architect",
  "version": "0.8.5",
  "private": true,
  "license": "Apache-2.0",
  "description": "A comprehensive application designed to model, visualize, and manage process flows within complex architectural environments. It enables users to define end-to-end workflows",
  "author": "Raúl A. Alzate <alzategomez.raul@gmail.com>",
  "copyright": "Copyright © 2025-2026 Raúl A. Alzate",
  "main": "build/main.js",
  "scripts": {
    "dev": "next dev",
    "next-dev": "next dev",
    "next-build": "next build",
    "ts:build": "tsc -p tsconfig.electron.json",
    "ts:watch": "tsc -p tsconfig.electron.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "move-out": "rimraf build/out && mv out build/out || move out build\\out",
    "electron-dev": "concurrently -k -n NEXT,TS,ELECTRON -c green,cyan,yellow \"npm:next-dev\" \"npm:ts:watch\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "npm run next-build && npm run ts:build && npm run move-out",
    "electron-build:mac": "npm run build && electron-builder --mac",
    "electron-build:win": "npm run build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "node scripts/repo-lint.mjs",
    "harness:selftest": "node scripts/harness-selftest.mjs",
    "docs:linkcheck": "node scripts/docs-linkcheck.mjs",
    "graph:check": "node scripts/graph-check.mjs",
    "graph:update": "graphify update",
    "graph:query": "graphify query",
    "sdd:new": "node scripts/sdd-github.mjs new",
    "sdd:tasks": "node scripts/sdd-github.mjs tasks",
    "sdd:status": "node scripts/sdd-github.mjs status",
    "screenshots": "tsx scripts/screenshots.ts",
    "skills:sync": "node scripts/sync-skills.mjs",
    "skills:check": "node scripts/sync-skills.mjs --check",
    "gate": "bash scripts/gate.sh",
    "gate:fast": "bash scripts/gate.sh fast",
    "hooks:install": "git config core.hooksPath .githooks && chmod +x .githooks/* && echo 'pre-commit instalado (core.hooksPath=.githooks)'",
    "rebuild": "electron-rebuild",
    "postinstall": "electron-builder install-app-deps",
    "release:updater-check": "node scripts/release-updater-check.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@litert-lm/core": "^0.13.1",
    "@mermaid-js/mermaid-cli": "^11.12.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@puppeteer/browsers": "^2.6.1",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^16.5.0",
    "electron-serve": "^3.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.475.0",
    "md-to-pdf": "^5.2.4",
    "mermaid": "^11.15.0",
    "next": "^15.5.6",
    "patch-package": "^8.0.0",
    "pdfjs-dist": "^6.0.227",
    "puppeteer": "^23.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^3.2.9",
    "@types/d3": "^7.4.3",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "^4.1.9",
    "concurrently": "^9.2.1",
    "electron": "^39.0.0",
    "electron-builder": "^26.0.12",
    "nodemon": "^3.1.10",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.22.5",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.alzategomezraul.processflowarchitect",
    "productName": "Processflow-Architect",
    "publish": [
      {
        "provider": "github",
        "owner": "raalzate",
        "repo": "processflow-architect",
        "releaseType": "draft"
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "buildResources"
    },
    "asarUnpack": [
      "node_modules/@mermaid-js/mermaid-cli/**",
      "node_modules/puppeteer/**",
      "node_modules/@puppeteer/browsers/**",
      "node_modules/.bin/**"
    ],
    "files": [
      "build/**/*",
      "!**/*.map"
    ],
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "artifactName": "${productName}-${version}.${ext}"
    }
  },
  "overrides": {
    "onnxruntime-node": "1.24.3",
    "onnxruntime-common": "^1.23.2"
  }
}
